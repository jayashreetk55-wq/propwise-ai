# ==============================================================================
# PropWise AI Backend Environment Configuration (Template)
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Application Metadata
SERVICE_NAME=propwise-backend
SERVICE_VERSION=1.0.0

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# NOTE: The application boots and passes unit tests even when PostgreSQL is offline.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propwise_db?schema=public

# Authentication & Security (JWT & Bcrypt)
# Use a strong, random secret of at least 32 characters in staging/production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_placeholder
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

